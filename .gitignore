# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Anomalib cache (used in v2.6+)
.anomalib_cache/

# Data + models (too big for git)
data/
datasets/
models/
*.pt
*.pth
*.ckpt

# anomalib training outputs — regeneratable, big
results/*/
results/*.log
!results/*.csv
!results/*.md
# ...but keep adjudication eval outputs (small CSV/JSON)
!results/adjudication/
!results/adjudication/**
# Keep compact controlled-run evidence, not checkpoints, maps, or training logs.
!results/controlled_*/
results/controlled_*/*
!results/controlled_*/*.json
!results/controlled_*/*.jsonl
!results/controlled_*/detector-only/
!results/controlled_*/advisory/
!results/controlled_*/override/

# IDE
.vscode/
.idea/
.DS_Store

# Env
.env
